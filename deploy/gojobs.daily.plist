<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template. `make install-daily` fills in __REPO__ and copies it to
  ~/Library/LaunchAgents. If the laptop sleeps through the hour, launchd runs
  the job once on wake.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>gojobs.daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/deploy/daily.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardErrorPath</key>
  <string>__REPO__/logs/launchd.log</string>
  <key>StandardOutPath</key>
  <string>__REPO__/logs/launchd.log</string>
</dict>
</plist>
